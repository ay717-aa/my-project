{
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    "files.encoding": "utf8"
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "C: build active file",
        "type": "process",
        "command": "gcc",
        "args": [
          "-std=c17",
          "-Wall",
          "-Wextra",
          "-g",
          "${file}",
          "-o",
          "${fileDirname}/${fileBasenameNoExtension}.exe"
        ],
        "options": {
          "cwd": "${fileDirname}"
        },
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "problemMatcher": [
          "$gcc"
        ]
      },
      {
        "label": "C: run active file",
        "type": "process",
        "command": "${fileDirname}/${fileBasenameNoExtension}.exe",
        "dependsOn": "C: build active file",
        "dependsOrder": "sequence",
        "options": {
          "cwd": "${fileDirname}"
        },
        "presentation": {
          "reveal": "always",
          "focus": true,
          "panel": "dedicated",
          "clear": true
        },
        "problemMatcher": []
      }
    ]
  }
}
